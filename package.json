{
  "name": "vault-brain",
  "version": "0.2.0",
  "private": true,
  "description": "Vault-agnostic agent brain: turns a spec-conforming Obsidian vault into an MCP knowledge server (retrieval + graph + memory). Repo: grandMA2-user.manual-agent.brain.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "index": "tsx src/cli.ts index",
    "query": "tsx src/cli.ts query",
    "serve": "tsx src/cli.ts serve",
    "eval": "tsx src/cli.ts eval",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^9.6.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "lint-staged": {
    "*.ts": "eslint"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.8.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0"
  }
}
