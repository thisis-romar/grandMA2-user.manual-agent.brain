#!/bin/sh
# vault-brain prepare-commit-msg — dynamic model attribution
# Reads CLAUDE_MODEL env var > git config user.ai-model > skips attribution
COMMIT_MSG_FILE=$1
MODEL="${CLAUDE_MODEL:-$(git config user.ai-model 2>/dev/null || true)}"
if [ -n "$MODEL" ] && ! grep -q "Co-Authored-By:" "$COMMIT_MSG_FILE"; then
  printf "\nCo-Authored-By: %s <noreply@anthropic.com>\n" "$MODEL" >> "$COMMIT_MSG_FILE"
fi
exit 0
